# Your own copy of the game and anything derived from it never goes in this repo.
# Keep it all here; none of these paths may be committed, pushed or attached to a PR.
/work/
/out/
/dump/
/build/
*.xbe
*.xbe.*
*.iso
*.7z
*.u
*.unr
*.utx
*.ukx
*.usx
*.uax
*.sgs
*.sgp
*.ka
*.kaw
*.lad
*.pdb
*.map

# Build output of our own tooling (never commit binaries).
tools/Sg1Tool/bin/
tools/Sg1Tool/obj/
tools/uelib/
__pycache__/
*.pyc

# Decompiled UnrealScript is game-derived: never commit it (AGENTS.md hard rule).
# Derived trees live under $WORK (default ~/sg1/work), outside the repo.
*.uc
/src/UnrealScript/
