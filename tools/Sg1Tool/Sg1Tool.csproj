<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Inventory and decompilation front-end for the SG1 dump, built on UELib.
    UELib is not vendored: fetch it with tools/fetch-uelib.sh (pinned commit) and either place it
    at tools/uelib or pass -p:UELibPath=/path/to/Unreal-Library.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Sg1Tool</AssemblyName>
    <RootNamespace>Sg1Tool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UELibPath Condition="'$(UELibPath)' == ''">$(MSBuildThisFileDirectory)../uelib</UELibPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(UELibPath)/src/Eliot.UELib.csproj" />
  </ItemGroup>

</Project>
